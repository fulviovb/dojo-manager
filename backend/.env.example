NODE_ENV=development
PORT=5000

# Database MySQL
DB_HOST=mysql
DB_PORT=3306
DB_NAME=escola_db
DB_USER=root
DB_PASSWORD=escola123

# JWT
JWT_SECRET=sua_chave_secreta_aqui
JWT_EXPIRES_IN=7d

# Check-in online (módulo satélite — ver checkin-online/), opcional: sem
# essas variáveis, /api/checkin-online/sincronizar retorna erro claro
CHECKIN_ONLINE_URL=http://localhost:4000
CHECKIN_ONLINE_API_KEY=mesma-chave-do-.env-do-checkin-online

# Cifra (AES-256-GCM) do login/senha do Sistema Incentivo online — 64 hex.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Guardar cópia fora do servidor: sem ela as senhas salvas não abrem mais.
CREDENCIAIS_KEY=gerar-com-o-comando-acima
