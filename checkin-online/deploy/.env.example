# Domínio público (DuckDNS ou outro) que vai apontar pra este servidor —
# precisa resolver pro IP externo da VM antes de subir o Caddy, senão o
# Let's Encrypt não consegue validar e emitir o certificado.
DOMAIN=escola-checkin.duckdns.org

# Porta interna do checkin-online (não precisa mudar — o Caddy é quem fica
# exposto nas portas 80/443, isso aqui é só a rede interna do compose)
PORT=4000

# Chave secreta compartilhada com o backend local
# (CHECKIN_ONLINE_API_KEY em backend/.env). Gere uma forte com:
#   openssl rand -hex 32
API_KEY=troque-por-uma-chave-secreta-longa
